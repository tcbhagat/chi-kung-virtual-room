{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constrovet.com/schemas/pose-frame-v1.json",
  "title": "Compact MediaPipe Pose Frame v1",
  "description": "A compact 33-landmark pose frame. The index of each item in p is the MediaPipe landmark index. Each item is [x, y, z, visibility].",
  "type": "object",
  "additionalProperties": false,
  "required": ["s", "t", "p"],
  "properties": {
    "s": { "type": "integer", "minimum": 0, "description": "Frame sequence" },
    "t": { "type": "number", "minimum": 0, "description": "Capture time in milliseconds" },
    "p": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": { "$ref": "#/$defs/k" },
      "description": "Landmarks ordered by MediaPipe index"
    }
  },
  "$defs": {
    "k": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "description": "x, normalized image coordinate" },
        { "type": "number", "description": "y, normalized image coordinate" },
        { "type": "number", "description": "z, depth relative to hip midpoint" },
        { "type": "number", "minimum": 0, "maximum": 1, "description": "visibility" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "landmarkTopology": [
    { "i": 0, "n": "nose" },
    { "i": 1, "n": "left_eye_inner" },
    { "i": 2, "n": "left_eye" },
    { "i": 3, "n": "left_eye_outer" },
    { "i": 4, "n": "right_eye_inner" },
    { "i": 5, "n": "right_eye" },
    { "i": 6, "n": "right_eye_outer" },
    { "i": 7, "n": "left_ear" },
    { "i": 8, "n": "right_ear" },
    { "i": 9, "n": "mouth_left" },
    { "i": 10, "n": "mouth_right" },
    { "i": 11, "n": "left_shoulder" },
    { "i": 12, "n": "right_shoulder" },
    { "i": 13, "n": "left_elbow" },
    { "i": 14, "n": "right_elbow" },
    { "i": 15, "n": "left_wrist" },
    { "i": 16, "n": "right_wrist" },
    { "i": 17, "n": "left_pinky" },
    { "i": 18, "n": "right_pinky" },
    { "i": 19, "n": "left_index" },
    { "i": 20, "n": "right_index" },
    { "i": 21, "n": "left_thumb" },
    { "i": 22, "n": "right_thumb" },
    { "i": 23, "n": "left_hip" },
    { "i": 24, "n": "right_hip" },
    { "i": 25, "n": "left_knee" },
    { "i": 26, "n": "right_knee" },
    { "i": 27, "n": "left_ankle" },
    { "i": 28, "n": "right_ankle" },
    { "i": 29, "n": "left_heel" },
    { "i": 30, "n": "right_heel" },
    { "i": 31, "n": "left_foot_index" },
    { "i": 32, "n": "right_foot_index" }
  ]
}
